#!/usr/bin/env sh

# Prefix commit message with current branch and ensure conventional header:
# "<branch> - type(scope)?: subject"

MSG_FILE="$1"
SOURCE="$2"

# Skip for merge or squash commits to avoid mangling auto-generated messages
if [ "$SOURCE" = "merge" ] || [ "$SOURCE" = "squash" ]; then
  exit 0
fi

# Determine current branch
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"

# Skip if detached HEAD or branch unavailable
if [ -z "$BRANCH" ] || [ "$BRANCH" = "HEAD" ]; then
  exit 0
fi

# Read the first line of the commit message
FIRST_LINE="$(head -n 1 "$MSG_FILE")"

# Strip an existing "<something> - " prefix to ensure current branch is used.
if printf '%s' "$FIRST_LINE" | grep -qE '^[^[:space:]]+ - '; then
  FIRST_LINE="$(printf '%s' "$FIRST_LINE" | sed -E 's/^[^[:space:]]+ - //')"
fi

# Ensure conventional type prefix when missing.
if printf '%s' "$FIRST_LINE" | grep -qE '^\w+(\([^)]+\))?!?:\s'; then
  CONVENTIONAL="$FIRST_LINE"
else
  CONVENTIONAL="chore: $FIRST_LINE"
fi

# Remove trailing period to satisfy subject-full-stop rule.
CONVENTIONAL="$(printf '%s' "$CONVENTIONAL" | sed -E 's/\.[[:space:]]*$//')"

# Prefix the first line with "<branch> - " and keep the rest intact.
{
  printf "%s - %s\n" "$BRANCH" "$CONVENTIONAL"
  # Append the rest of the original message starting from line 2, if any.
  tail -n +2 "$MSG_FILE" 2>/dev/null || true
} > "$MSG_FILE.tmp" && mv "$MSG_FILE.tmp" "$MSG_FILE"
